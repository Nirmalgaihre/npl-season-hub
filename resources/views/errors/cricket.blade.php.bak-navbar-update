<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ $code }} — {{ $title }} | NPL Season Hub</title>

    <style>
        :root {
            color-scheme: light;
            --navy: #101b32;
            --red: #e11d48;
            --muted: #64748b;
            --line: #e2e8f0;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                         BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #f8fafc;
            color: var(--navy);
        }

        a { text-decoration: none; }

        .topbar {
            background: white;
            border-bottom: 1px solid var(--line);
        }

        .topbar-inner {
            max-width: 1120px;
            min-height: 72px;
            margin: auto;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            color: var(--navy);
            font-size: 14px;
            font-weight: 900;
            letter-spacing: -.3px;
        }

        .brand-mark {
            display: grid;
            width: 42px;
            height: 42px;
            place-items: center;
            color: white;
            background: var(--red);
            border-radius: 13px;
            font-size: 12px;
            box-shadow: 0 5px 12px #e11d4826;
        }

        .league-label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        main {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
            padding: 48px 24px 32px;
        }

        .error-card {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 330px;
            overflow: hidden;
            border-radius: 28px;
            background: white;
            border: 1px solid var(--line);
            box-shadow: 0 18px 55px rgba(15, 23, 42, .07);
        }

        .copy {
            padding: 56px 48px;
            align-self: center;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 11px;
            border: 1px solid #fecdd3;
            border-radius: 999px;
            color: #be123c;
            background: #fff1f2;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--red);
        }

        h1 {
            margin: 22px 0 0;
            color: var(--navy);
            font-size: clamp(30px, 4.5vw, 49px);
            font-weight: 950;
            letter-spacing: -2px;
            line-height: 1.1;
        }

        .code {
            margin-top: 18px;
            color: var(--red);
            font-size: clamp(64px, 10vw, 105px);
            font-weight: 1000;
            letter-spacing: -7px;
            line-height: 1;
        }

        .message {
            max-width: 440px;
            margin-top: 18px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.9;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 28px;
        }

        .button {
            display: inline-flex;
            min-height: 46px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 17px;
            border: 1px solid var(--line);
            border-radius: 12px;
            color: var(--navy);
            background: white;
            font-size: 13px;
            font-weight: 850;
            transition: .18s ease;
        }

        .button:hover { transform: translateY(-2px); }

        .button-primary {
            color: white;
            border-color: var(--navy);
            background: var(--navy);
        }

        .button-primary:hover {
            border-color: var(--red);
            background: var(--red);
        }

        .illustration {
            position: relative;
            display: flex;
            min-height: 420px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 28px;
            background:
                radial-gradient(circle at 50% 35%, #33466b 0, transparent 45%),
                linear-gradient(150deg, #172541, #0a1223);
            color: white;
        }

        .illustration::before,
        .illustration::after {
            position: absolute;
            width: 250px;
            height: 250px;
            border: 1px solid #ffffff13;
            border-radius: 50%;
            content: "";
        }

        .illustration::after {
            width: 340px;
            height: 340px;
        }

        .pitch {
            position: absolute;
            bottom: -45px;
            left: -20%;
            width: 140%;
            height: 145px;
            border-radius: 50% 50% 0 0;
            background: linear-gradient(180deg, #244a42, #15332e);
            transform: rotate(-5deg);
        }

        .cricket-ball {
            position: relative;
            z-index: 2;
            display: grid;
            width: 116px;
            height: 116px;
            place-items: center;
            border: 5px solid #ffffff25;
            border-radius: 50%;
            background: linear-gradient(145deg, #fb7185, #be123c);
            box-shadow: 0 18px 45px #0005;
            font-size: 54px;
            transform: rotate(-12deg);
        }

        .ball-seam {
            position: absolute;
            width: 100px;
            height: 42px;
            border-top: 3px dashed #fff9;
            border-bottom: 3px dashed #fff9;
            border-radius: 50%;
            transform: rotate(-55deg);
        }

        .big-emoji {
            position: relative;
            z-index: 3;
            margin-top: 26px;
            font-size: 55px;
            filter: drop-shadow(0 8px 9px #0005);
        }

        .illustration-title {
            position: relative;
            z-index: 3;
            margin-top: 13px;
            text-align: center;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .illustration-subtitle {
            position: relative;
            z-index: 3;
            margin-top: 8px;
            color: #bdc9dc;
            text-align: center;
            font-size: 11px;
        }

        .bottom-note {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: 22px;
            padding: 17px 4px;
            color: var(--muted);
            font-size: 11px;
        }

        .bottom-note strong { color: var(--navy); }

        @media (max-width: 760px) {
            main { padding: 28px 16px 20px; }

            .topbar-inner {
                min-height: 64px;
                padding: 12px 16px;
            }

            .league-label { font-size: 9px; letter-spacing: .7px; }

            .error-card {
                grid-template-columns: 1fr;
                border-radius: 22px;
            }

            .copy { padding: 34px 25px 30px; }

            h1 { letter-spacing: -1.3px; }

            .code { letter-spacing: -5px; }

            .illustration {
                min-height: 285px;
                padding: 22px;
            }

            .cricket-ball {
                width: 78px;
                height: 78px;
                font-size: 38px;
            }

            .ball-seam { width: 68px; height: 28px; }

            .big-emoji { margin-top: 12px; font-size: 38px; }

            .illustration-title { margin-top: 7px; }

            .pitch { height: 90px; }
        }

        @media (max-width: 380px) {
            .copy { padding: 27px 18px; }
            .actions { flex-direction: column; }
            .button { width: 100%; }
            .brand { font-size: 12px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="{{ url('/') }}">
                <span class="brand-mark">NPL</span>
                <span>NPL Season Hub</span>
            </a>
            <span class="league-label">Nepal Premier League</span>
        </div>
    </header>

    <main>
        <section class="error-card">
            <div class="copy">
                <span class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    {{ $label }}
                </span>

                <div class="code">{{ $code }}</div>
                <h1>{{ $title }}</h1>
                <p class="message">{{ $message }}</p>

                <div class="actions">
                    <a class="button button-primary" href="{{ url('/') }}">
                        <span aria-hidden="true">⌂</span>
                        Back to homepage
                    </a>
                    <a class="button" href="{{ url('/fixtures') }}">
                        Explore matches <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <aside class="illustration" aria-label="Cricket illustration">
                <div class="cricket-ball" aria-hidden="true">
                    <span class="ball-seam"></span>
                    🏏
                </div>
                <div class="big-emoji" aria-hidden="true">{{ $emoji }}</div>
                <div class="illustration-title">The game goes on</div>
                <div class="illustration-subtitle">NPL Season Hub · Cricket, always</div>
                <div class="pitch"></div>
            </aside>
        </section>

        <footer class="bottom-note">
            <span><strong>NPL Season Hub</strong> · Follow every innings.</span>
            <span>Cricket brings us together.</span>
        </footer>
    </main>
</body>
</html>
